# ============================================================
# Bhoomi Sakha - Production & Development Environment Template
# ============================================================
# Copy this file to .env and provide your actual secrets.
# NEVER commit .env or real credentials to source control.

# Application Environment Mode ('production', 'development', 'testing')
ENVIRONMENT=development
PORT=8000

# ------------------------------------------------------------
# Database (MongoDB Atlas or self-hosted)
# ------------------------------------------------------------
# In production, MONGODB_URI is strictly required; silent in-memory fallback is prohibited.
# In local development, leaving MONGODB_URI empty activates the isolated in-memory database store.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=bhoomi_sakha
USE_IN_MEMORY_DB=0

# ------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------
# JWT signing secret (Must be set to a high-entropy secret in production; default fallback forbidden in prod)
JWT_SECRET=your-random-32-character-secret-key-here
JWT_EXPIRATION_HOURS=24

# Administrative key required for officer self-registration (Must be explicitly configured in prod)
OFFICER_REGISTRATION_KEY=replace-with-a-strong-secret

# ------------------------------------------------------------
# Cloud Document Storage (AWS S3 or S3-Compatible Cloud Storage)
# ------------------------------------------------------------
# STORAGE_PROVIDER options: 's3' (production object storage) or 'mock' (local/testing)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bhoomi-sakha-production-documents
# Optional: Set for Cloudflare R2, MinIO, or custom S3 endpoint
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------
# Comma-separated list of permitted origins (e.g. Vercel frontend, custom domain)
ALLOWED_ORIGINS=https://bhoomi-sakha.vercel.app,http://localhost:5173
FRONTEND_URL=https://bhoomi-sakha.vercel.app

# ------------------------------------------------------------
# Abuse Resistance & Rate Limiting
# ------------------------------------------------------------
# Set to 1 to enable rate limiting on /api/auth and /predict; set to 0 to disable in testing
RATE_LIMIT_ENABLED=1
